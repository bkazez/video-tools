#!/usr/bin/env python3
"""cap-stills - shorten every still stretch of a video to at most MAX seconds,
and leave everything that moves at its own speed.

    cap-stills IN.mp4 OUT.mp4 [--max 3.5] [--fps 60]

A filmed UI test on a busy Mac spends most of its length waiting: XCUITest
takes seconds to find an element, and the screen holds still meanwhile. Playing
the whole film faster rushes the motion with the waits; this cuts the waits.
Each stretch where the picture holds still (ffmpeg freezedetect at -60 dB) for
longer than MAX keeps its first MAX seconds, so a hold the test meant, a page
left up to be read, is still a hold. The film goes to a constant FPS first,
since a simulator recording draws a frame only when something moves.
"""
import argparse
import re
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument("src")
parser.add_argument("out")
parser.add_argument("--max", type=float, default=3.5)
parser.add_argument("--fps", type=int, default=60)
args = parser.parse_args()

found = subprocess.run(
    ["ffmpeg", "-v", "info", "-i", args.src, "-vf", f"fps={args.fps},freezedetect=n=-60dB:d={args.max}",
     "-map", "0:v", "-f", "null", "-"], capture_output=True, text=True, check=True).stderr
starts = [float(s) for s in re.findall(r"freeze_start: ([\d.]+)", found)]
ends = [float(s) for s in re.findall(r"freeze_end: ([\d.]+)", found)]
length = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", args.src],
                              capture_output=True, text=True, check=True).stdout)
ends += [length] * (len(starts) - len(ends))
cuts = [(start + args.max, end) for start, end in zip(starts, ends) if end - start > args.max]
dropped = sum(end - start for start, end in cuts)
cut = "+".join(f"between(t,{a:.4f},{b:.4f})" for a, b in cuts) or "0"
subprocess.run(
    ["ffmpeg", "-v", "error", "-y", "-i", args.src, "-vf",
     f"fps={args.fps},select='not({cut})',setpts=N/{args.fps}/TB",
     "-r", str(args.fps), "-c:v", "libx264", "-crf", "8", "-preset", "fast", "-pix_fmt", "yuv420p", "-an", args.out],
    check=True)
print(f"cap-stills: {len(cuts)} still stretches cut to {args.max} s, {length:.1f} s -> {length - dropped:.1f} s", file=sys.stderr)
