#!/usr/bin/env python3
"""Whether a video's motion is smooth: no freezes, no jumps, an even cadence.

A freeze and then a jump in a recording of an app is the app failing to draw on
time. It is the app's fault until the same motion, recorded on an iPhone, is
measured smooth (visual-test-tools bin/hitches); a slow simulator only shows
sooner what a phone will show later. Resampling a recording to a frame rate it
was not drawn at adds a judder of its own, a step of one source frame and then
two. Both read as jerky, and neither is easy to see in one viewing on a laptop.
This measures it.

For each frame it finds how far each part of the picture went since the frame
before (lib/motion.py: phase correlation block by block, over the blocks that
change during the video). Each block's step is compared with that block's own
steps on either side of it (a twentieth of a second each way), which a camera
easing in or out follows and a stall does not, and a frame's ratio is the median
over the blocks that are moving. Each layer is judged against itself: a phone or
a card held still over a room drifting behind it is two layers, and one median
over all the blocks flips between them from frame to frame.

  freeze   a step under FREEZE x its neighbours', between moving frames
  jump     a step over JUMP x its neighbours'
  cadence  the steps' spread, median |step / neighbours' - 1|, over CADENCE
  hold     a frame that repeats the one before, with the picture changing on most
           frames on both sides of it, and alike just before and just after: a slow picture drawn at half the frame rate,
           or a map that stops drawing for a few frames, which is too small a step
           for the phase correlation above to judge

A picture that is not moving, or barely, is not judged: a still is not a stall.
Barely is under half an analysis pixel a frame (about a pixel of a 1080p film):
a hitch that small cannot be seen.
Nor are the frames beside a rest of REST seconds, where motion starts or settles.
Nor is a span given with --skip: product-video passes its own camera moves, which
it draws on a curve, since a move eased to a stop slows by twice a frame as it
lands and would read as a freeze or a jump.
Nor is a cut, where nothing in one frame has a counterpart in the next. Exit 1
on any fault, with the worst frames and their times.

    motion-smoothness film.mp4
    motion-smoothness --loop loop.mp4          # the last frame into the first, too
    motion-smoothness --json film.mp4          # every step, for a plot
    motion-smoothness --skip 7.0-7.75 --skip 9.0-9.5 film.mp4
    motion-smoothness --frames out/ film.mp4   # each fault printed, as a picture: the frame
                                               # before it beside the frame after, so one look
                                               # says what jumped, with no frame-by-frame viewing
"""
import argparse, json, os, subprocess, sys, warnings

import numpy as np

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import motion  # noqa: E402

FREEZE = 0.4
JUMP = 1.6
CADENCE = 0.1
NEAR = 0.05              # seconds either side that are a step's neighbours
STILL = 0.5              # a local median under this many analysis pixels a frame is a still
REST = 0.25              # seconds the picture stands still to be at rest, not stalled
LAYER = 0.25             # under this share of the blocks moving, details are changing (digits, a title landing), not the picture moving
HELD = 0.03              # mean grey levels a frame differs from the last by, at most, to repeat it
CHANGED = 0.1            # mean grey levels a frame differs from the last by, at least, to change
AROUND = 0.2             # seconds either side of a held frame
BUSY = 0.4               # share of those frames that change, both sides, for a hold to be a stall
ALIKE = 3.0              # at most this ratio between the changes just before a hold and just after


def shown(times):
    """Which frames a player shows, and the frame time: a frame on screen for under half
    a frame's time (a recording's copy of the picture 2 ms after it) is not seen, so its
    successor stands for it."""
    lasts = np.diff(times, append=times[-1] + np.median(np.diff(times))) if len(times) > 1 else np.ones(len(times))
    typical = np.median(lasts[lasts > 0]) if (lasts > 0).any() else 1 / 30
    return lasts >= typical / 2, typical


def blocks(a, b):
    """How far each block went from a to b, and whether b is the same picture at all. A
    block with no clear peak (flat, dim or noisy picture) says nothing: NaN."""
    dx, dy, peak = motion.vectors(a, b)
    return np.where(peak >= motion.PEAK, np.hypot(dx, dy), np.nan), bool(np.median(peak) >= motion.PEAK)


def measure(path, loop):
    width, height, times = motion.probe(path)
    seen, typical = shown(times)
    times = times[seen]
    corners = motion.moving_blocks(motion.spread(path, width, height))
    count = max(len(times) - 1 + loop, 0)
    fps = 1 / typical
    if not corners:
        return np.zeros((count, 1)), np.ones(count, bool), times, fps
    steps, same, first, before = [], [], None, None
    for frame, keep in zip(motion.frames(path, width, height), seen):
        if not keep:
            continue
        frame = motion.spectra(frame, corners)
        if before is None:
            first = frame
        else:
            steps.append(blocks(before, frame))
        before = frame
    if loop:
        steps.append(blocks(before, first))
    same = np.array([kept for _, kept in steps], bool)
    steps = np.array([moved for moved, _ in steps]) if steps else np.zeros((0, len(corners)))
    gaps = np.diff(times)[:len(steps)]
    if len(gaps) == len(steps) and len(gaps) and np.ptp(gaps) > 1e-3:
        # A recording's frames are not evenly spaced; judge speed, not step.
        steps = steps * typical / np.maximum(gaps, 1e-4)[:, None]
    return steps, same, times, fps


def holds(path, fps):
    """Each held frame inside changing pictures: (index of the step, run length)."""
    width, height, times = motion.probe(path)
    seen, _ = shown(times)
    change, before = [], None
    for frame, keep in zip(motion.frames(path, width, height), seen):
        if not keep:
            continue
        frame = frame.astype(np.float32)
        if before is not None:
            change.append(float(np.abs(frame - before).mean()))
        before = frame
    change = np.array(change)
    near = max(2, int(round(AROUND * fps)))
    held = change < HELD
    changing = change > CHANGED
    def busy(span):
        return len(span) > 0 and span.mean() >= BUSY
    stalls = [i for i in np.flatnonzero(held)
              if busy(changing[max(0, i - near):i]) and busy(changing[i + 1:i + 1 + near])]
    runs = []
    for i in stalls:
        if runs and i == runs[-1][0] + runs[-1][1]:
            runs[-1] = (runs[-1][0], runs[-1][1] + 1)
        else:
            runs.append((i, 1))
    # One motion stalling changes the picture alike just before the hold and just after;
    # a title that has landed and the next one knocking in do not.
    def alike(i, run):
        if i == 0 or i + run >= len(change):
            return False
        before, after = change[i - 1], change[i + run]
        return min(before, after) > CHANGED and max(before, after) <= ALIKE * min(before, after)
    return [(i, run) for i, run in runs if alike(i, run)]


def beside_rest(moves, reach, fps):
    """Frames within REACH of a rest of REST seconds or more. Motion that starts from
    rest, or settles into it, has no motion on one side to be judged against: a curve
    that starts steep, as an iOS animation does, is not a freeze and then a jump."""
    near = np.zeros(len(moves), dtype=bool)
    edges = np.flatnonzero(np.diff(np.r_[0, (~moves).astype(int), 0]))
    for start, end in zip(edges[::2], edges[1::2]):
        if end - start >= max(1, int(round(REST * fps))):
            for edge in (start, end):
                near[max(0, edge - reach):min(len(moves), edge + reach)] = True
    return near


def judge(steps, same, fps, skip=(), times=None):
    """Each frame's step, its neighbours', their ratio, whether it was judged, the faults
    and the spread, from every block's step (frames x blocks)."""
    reach = max(2, int(round(NEAR * fps)))
    count = len(steps)
    local = np.full(steps.shape, np.nan)
    for i in range(count):
        around = np.r_[max(0, i - reach):i, i + 1:min(count, i + reach + 1)]
        around = around[same[around]]
        if len(around):
            with np.errstate(all="ignore"), warnings.catch_warnings():
                warnings.simplefilter("ignore", RuntimeWarning)
                local[i] = np.nanmedian(steps[around], axis=0)
    moving = (np.nan_to_num(local) > STILL) & ~np.isnan(steps)
    layer = moving.sum(axis=1) >= max(1, LAYER * steps.shape[1])
    own = ((np.nan_to_num(steps) > STILL).sum(axis=1) >= max(1, LAYER * steps.shape[1])) | ~same
    judged = same & layer & ~beside_rest(own, reach, fps)
    for start, end in skip:
        judged &= ~((times[:count] >= start - NEAR) & (times[:count] <= end + NEAR))
    ratio, step, around = np.ones(count), np.median(np.nan_to_num(steps), axis=1), np.median(np.nan_to_num(local), axis=1)
    for i in np.flatnonzero(layer):
        ratio[i] = np.median(steps[i, moving[i]] / local[i, moving[i]])
        step[i], around[i] = np.median(steps[i, moving[i]]), np.median(local[i, moving[i]])
    ratio = np.where(judged, ratio, 1.0)
    faults = [("freeze", i) for i in np.flatnonzero(judged & (ratio < FREEZE))] + \
             [("jump", i) for i in np.flatnonzero(judged & (ratio > JUMP))]
    spread = float(np.median(np.abs(ratio[judged] - 1))) if judged.any() else 0.0
    return step, around, ratio, judged, faults, spread


def picture(video, before, after, out):
    """The frame shown at BEFORE beside the one shown at AFTER, half size, in OUT."""
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{before:.4f}", "-i", video, "-ss", f"{after:.4f}", "-i", video,
                    "-filter_complex", "[0:v]scale=iw/2:-2[a];[1:v]scale=iw/2:-2[b];[a][b]hstack",
                    "-frames:v", "1", out], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("video")
    parser.add_argument("--loop", action="store_true", help="also judge the last frame into the first")
    parser.add_argument("--json", action="store_true", help="print every step")
    parser.add_argument("--worst", type=int, default=8, help="how many faults to print")
    parser.add_argument("--skip", action="append", default=[], metavar="START-END",
                        help="seconds not judged: the film's own camera moves")
    parser.add_argument("--frames", metavar="DIR", help="save each printed fault's frames before and after it here")
    args = parser.parse_args()

    steps, same, times, fps = measure(args.video, args.loop)
    skip = [tuple(float(t) for t in span.split("-")) for span in args.skip]
    steps, local, ratio, judged, faults, spread = judge(steps, same, fps, skip, times)
    freezes = sum(1 for kind, _ in faults if kind == "freeze")
    jumps = len(faults) - freezes
    stalls = holds(args.video, fps)
    cuts = int((~same).sum())
    if args.json:
        print(json.dumps({"fps": fps, "steps": steps.round(3).tolist(), "ratio": ratio.round(3).tolist(),
                          "judged": judged.tolist(), "spread": spread, "freezes": freezes, "jumps": jumps}))
    summary = (f"{args.video}: {len(steps)} steps, {int(judged.sum())} moving, {cuts} cuts; median step "
               f"{np.median(steps[judged]) if judged.any() else 0:.2f} px; spread {spread:.3f} "
               f"(limit {CADENCE}); {freezes} freezes, {jumps} jumps, {len(stalls)} holds")
    worst = sorted(faults, key=lambda f: -abs(np.log(max(ratio[f[1]], 1e-3))))[:args.worst]
    if args.frames:
        os.makedirs(args.frames, exist_ok=True)
    for kind, i in sorted(worst, key=lambda f: f[1]):
        when = times[i + 1] if i + 1 < len(times) else len(steps) / fps
        print(f"  {kind} into frame {i + 1} ({when:.2f} s): step {steps[i]:.2f} px, "
              f"{ratio[i]:.2f}x the {local[i]:.2f} px around it", file=sys.stderr)
        if args.frames and i + 1 < len(times):
            out = os.path.join(args.frames, f"{when:07.2f}s-{kind}.png")
            picture(args.video, times[i], times[i + 1], out)
            print(f"    {out}", file=sys.stderr)
    for i, run in stalls[:args.worst]:
        when = times[i + 1] if i + 1 < len(times) else len(steps) / fps
        print(f"  hold at {when:.2f} s: {run} frame{'s' if run > 1 else ''} repeated while the picture moves",
              file=sys.stderr)
    if faults or stalls or spread > CADENCE:
        print("motion-smoothness: JERKY " + summary, file=sys.stderr)
        sys.exit(1)
    print("motion-smoothness: smooth " + summary, file=sys.stderr if args.json else sys.stdout)


if __name__ == "__main__":
    main()
