#!/usr/bin/env python3
"""Build a DaVinci Resolve project from a YAML spec: bins, clip attributes, timelines.

Clicking a project together is fine once. It stops being fine when the media has
attributes that must be right and are invisible when they are wrong -- a log
clip whose input colour space was never set looks merely flat, and a
slow-motion clip left at its container rate looks merely wrong-length. A spec
file makes those explicit, reviewable, and repeatable, and it can be rebuilt
after someone reshuffles the bins.

Requires Resolve to be RUNNING, with Preferences > System > General >
"External scripting using" set to Local.

Usage:
    build-resolve-project spec.yaml
    build-resolve-project spec.yaml --root /path/to/session   # resolve relative paths
    build-resolve-project spec.yaml --dry-run

Spec:

    project: 2026-04-07 Brahms Faure
    settings:                       # any Resolve project setting, by its API name
      timelineResolutionWidth: "3840"
      timelineResolutionHeight: "2160"
      timelineFrameRate: "25"
      colorScienceMode: davinciYRGBColorManagedv2
      colorSpaceTimeline: Rec.709 Gamma 2.4
      colorSpaceOutput: Rec.709 Gamma 2.4

    bins:
      - name: "01 Sony A-cam (S-Log3)"
        glob: "Video/C0*.MP4"
        properties:                 # applied to every clip in the bin
          Data Level: Full          # NOT "Data Levels"; Resolve names it singular
          Input Color Space: S-Gamut3.Cine/S-Log3
          FPS: "50"                 # undoes 2x S&Q slow motion, losslessly

    timelines:
      - name: "Fauré — candidate A"
        bin: "04 Timelines"
        replace: true               # delete an existing timeline of this name
        audio:
          file: "Fauré-001.wav"
          at: 4.0                   # timeline seconds; omit to lay it at the head
        tracks:                     # optional names, by video track number
          2: "keys -- nudge to sync"
        clips:
          - {file: DJI_0690.MP4, start: 195.0,  duration: 4.0,    at: 0.0}
          - {file: C0485.MP4,    start: 10.828, duration: 83.132, at: 4.0}
          - {file: DJI_0690.MP4, start: 250.0,  duration: 5.0,    at: 87.132}
          - {file: C0490.MP4,  start: 110.44, duration: 30.0, at: 96.4, track: 2}
          - {file: C0489.MP4,  start: 100.0,  duration: 9.0,  at: 105.0, track: 2,
             transform: {ZoomX: 1.9, ZoomY: 1.9, Pan: -1824, Tilt: -42}}
        markers:                    # applied to an EXISTING timeline too
          - {at: 0.0, color: Green, name: "the take", note: "why it was chosen"}

    deliver:                        # optional; renders once everything is built
      dir: "~/Desktop/Renders/Faure audition"
      format: mp4
      codec: H264
      width: 1920
      height: 1080
      timelines: ["Fauré — candidate A"]

`start` is always REAL seconds into the clip; `at` is where it lands on the
timeline. Omit `at` and clips are laid end to end in the order written.

`transform` sets any of Resolve's sizing properties on the clip (ZoomX, ZoomY,
Pan, Tilt, RotationAngle, CropLeft...), which is how a punch-in on a wide shot
becomes a second angle. Pan and Tilt are in timeline pixels after the zoom.

`track` puts a clip on a video track above the first, which is how a shot whose
sync is still in doubt is handed over: it sits on its own track, the track below
carries a shot that covers the same seconds, and moving it is a drag rather than
a rebuild. Clips laid end to end advance their own track's position, not a
shared one.
"""
import argparse, glob, os, sys
import yaml

MODULES = "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules/"


def connect():
    sys.path.append(MODULES)
    try:
        import DaVinciResolveScript as dvr
    except ImportError:
        sys.exit("cannot import DaVinciResolveScript -- is Resolve installed?")
    r = dvr.scriptapp("Resolve")
    if r is None:
        sys.exit("Resolve is not answering. Start it, and set Preferences > System > "
                 "General > 'External scripting using' to Local.")
    return r


def find_bin(mp, name):
    root = mp.GetRootFolder()
    for f in root.GetSubFolderList():
        if f.GetName() == name:
            return f
    return mp.AddSubFolder(root, name)


def find_timeline(project, name):
    for i in range(1, project.GetTimelineCount() + 1):
        tl = project.GetTimelineByIndex(i)
        if tl and tl.GetName() == name:
            return tl
    return None


def set_markers(tl, markers, fps):
    """Put a spec's markers on a timeline, replacing any already at that frame.

    What a marker is for here: saying something about a take -- which one was
    chosen, where the picture runs out, what still needs a look -- inside the
    timeline where the work happens, rather than in a file nobody has open. It
    is also the only annotation Resolve's API offers that does not mean
    rebuilding the timeline, since renaming one destroys its edits.

    `at` is timeline seconds from the start; Resolve's AddMarker counts frames
    from the start frame, not absolute frames, so the two agree without
    involving GetStartFrame. Re-running replaces rather than stacks, because a
    spec is meant to be applied twice.
    """
    for marker in markers or []:
        frame = int(round(float(marker.get("at", 0)) * fps))
        if frame in (tl.GetMarkers() or {}):
            tl.DeleteMarkerAtFrame(frame)
        ok = tl.AddMarker(frame, marker.get("color", "Blue"),
                          marker.get("name", ""), marker.get("note", ""),
                          int(round(float(marker.get("duration", 1)) * fps)) or 1,
                          marker.get("data", ""))
        state = "ok" if ok else "REFUSED"
        print(f"  marker at {marker.get('at', 0)}s ({marker.get('color', 'Blue')}): "
              f"{marker.get('name', '')!r}  {state}")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("spec")
    ap.add_argument("--root", help="base for relative paths (default: the spec's folder)")
    ap.add_argument("--dry-run", action="store_true", help="say what would happen")
    args = ap.parse_args()

    spec = yaml.safe_load(open(args.spec, encoding="utf-8"))
    root = args.root or os.path.dirname(os.path.abspath(args.spec))

    def resolve_path(p):
        return p if os.path.isabs(p) else os.path.join(root, p)

    # Expand every glob first, so a typo in a path is reported before anything is
    # created rather than halfway through building a project.
    plan = []
    for b in spec.get("bins", []):
        pats = b.get("glob") or b.get("files") or []
        if isinstance(pats, str):
            pats = [pats]
        files = []
        for pat in pats:
            hits = sorted(glob.glob(resolve_path(pat)))
            if not hits:
                print(f"  !! nothing matches {pat!r}")
            files += hits
        plan.append((b, files))
        print(f"bin {b['name']!r}: {len(files)} files")

    if args.dry_run:
        for b, files in plan:
            for f in files:
                print(f"   {b['name']}  <- {os.path.basename(f)}")
        for t in spec.get("timelines", []):
            print(f"timeline {t['name']!r}: audio={t.get('audio')} "
                  f"clips={[c['file'] for c in t.get('clips', [])]}")
        return

    resolve = connect()
    pm = resolve.GetProjectManager()
    name = spec["project"]
    project = pm.CreateProject(name) or pm.LoadProject(name)
    if not project:
        sys.exit(f"could not create or open project {name!r}")
    print(f"\nproject: {project.GetName()}")

    # Applied in the order written, because some settings gate others: colour
    # spaces are read-only until isAutoColorManage is 0, and setting them first
    # is silently refused.
    for k, v in (spec.get("settings") or {}).items():
        ok = project.SetSetting(k, str(v))
        got = project.GetSetting(k)
        flag = "ok" if ok else "REFUSED"
        print(f"  setting {k} = {v}   {flag}" + ("" if ok else f" (still {got!r})"))

    mp = project.GetMediaPool()
    ms = resolve.GetMediaStorage()
    imported = {}                     # basename -> MediaPoolItem

    for name in spec.get("delete_timelines", []):
        for i in range(project.GetTimelineCount(), 0, -1):
            tl = project.GetTimelineByIndex(i)
            if tl and tl.GetName() == name:
                mp.DeleteTimelines([tl])
                print(f"  deleted timeline {name!r}")

    for b, files in plan:
        if not files:
            continue
        folder = find_bin(mp, b["name"])
        mp.SetCurrentFolder(folder)
        existing = {c.GetName(): c for c in folder.GetClipList()}
        todo = [f for f in files if os.path.basename(f) not in existing]
        items = ms.AddItemListToMediaPool(todo) if todo else []
        for c in folder.GetClipList():
            imported[c.GetName()] = c
        print(f"\n{b['name']}: {len(items)} imported, "
              f"{len(files) - len(todo)} already there")
        props = b.get("properties") or {}
        if props:
            for c in folder.GetClipList():
                for k, v in props.items():
                    if not c.SetClipProperty(k, str(v)):
                        print(f"    !! {c.GetName()}: {k} = {v} REFUSED")
            shown = ", ".join(f"{k}={v}" for k, v in props.items())
            print(f"    set on {len(folder.GetClipList())} clips: {shown}")

    for t in spec.get("timelines", []):
        tl_bin = t.get("bin", "Timelines")
        mp.SetCurrentFolder(find_bin(mp, tl_bin))
        fps = float(project.GetSetting("timelineFrameRate"))
        standing = find_timeline(project, t["name"])
        if standing and t.get("replace"):
            mp.DeleteTimelines([standing])
            print(f"\nreplacing existing timeline {t['name']!r}")
            standing = None
        if standing:
            # Rebuilding would throw away hand corrections, which is why this
            # skips by default. Markers are set anyway: a note about a timeline
            # is not the timeline, and having to rebuild one to annotate it
            # would make annotating it the destructive act.
            print(f"\ntimeline {t['name']!r} already exists, left as it is")
            set_markers(standing, t.get("markers"), fps)
            continue
        tl = mp.CreateEmptyTimeline(t["name"])
        if not tl:
            print(f"\n!! could not create timeline {t['name']!r}")
            continue
        project.SetCurrentTimeline(tl)
        start_frame = int(tl.GetStartFrame())
        print(f"\ntimeline {t['name']!r} at {fps:g} fps, starts at frame {start_frame}")

        audio = t.get("audio")
        if isinstance(audio, str):
            audio = {"file": audio}
        if audio:
            a = imported.get(os.path.basename(audio["file"]))
            if not a:
                print(f"  !! audio {audio['file']!r} is not in any bin")
            else:
                at = start_frame + int(round(float(audio.get("at", 0)) * fps))
                info = {"mediaPoolItem": a, "mediaType": 2, "trackIndex": 1,
                        "recordFrame": at}
                # An audio start/duration is in the FILE's own seconds. Without
                # this the take plays from its first sample, which is where the
                # talking before a take lives.
                if "start" in audio or "duration" in audio:
                    afps = float(a.GetClipProperty("FPS") or fps)
                    sf = int(round(float(audio.get("start", 0)) * afps))
                    info["startFrame"] = sf
                    if "duration" in audio:
                        info["endFrame"] = sf + int(round(float(audio["duration"]) * afps)) - 1
                mp.AppendToTimeline([info])
                where = f" from {audio['start']:g}s" if "start" in audio else ""
                print(f"  audio  {a.GetName()}{where} at timeline frame {at}")

        clips = t.get("clips", [])
        wanted_tracks = max([int(c.get("track", 1)) for c in clips] or [1])
        while tl.GetTrackCount("video") < wanted_tracks:
            tl.AddTrack("video")
        for n, label in (t.get("tracks") or {}).items():
            tl.SetTrackName("video", int(n), str(label))

        record = {}                   # per track, so end-to-end laying is per track
        for c in clips:
            item = imported.get(os.path.basename(c["file"]))
            if not item:
                print(f"  !! {c['file']!r} is not in any bin")
                continue
            track = int(c.get("track", 1))
            # startFrame/endFrame count in the CLIP's own frames, which after an
            # FPS override are real-time frames at the capture rate. recordFrame
            # counts in TIMELINE frames. Mixing the two is the usual bug here.
            cfps = float(item.GetClipProperty("FPS"))
            sf = int(round(float(c.get("start", 0)) * cfps))
            dur = float(c.get("duration", 0))
            ef = sf + int(round(dur * cfps)) - 1
            where = record.get(track, start_frame)
            if "at" in c:
                where = start_frame + round(float(c["at"]) * fps)
            info = {"mediaPoolItem": item, "mediaType": 1, "trackIndex": track,
                    "startFrame": sf, "endFrame": ef,
                    "recordFrame": int(round(where))}
            if not mp.AppendToTimeline([info]):
                print(f"  !! could not place {c['file']}")
                continue
            placed = (tl.GetItemListInTrack("video", track) or [])[-1]
            for key, value in (c.get("transform") or {}).items():
                if not placed.SetProperty(key, float(value)):
                    print(f"    !! {c['file']}: {key} = {value} REFUSED")
            print(f"  V{track}     {item.GetName()} frames {sf}-{ef} @{cfps:g}fps "
                  f"({dur:.3f}s) at timeline frame {int(where)}"
                  + (f"  {c['transform']}" if c.get("transform") else ""))
            record[track] = where + round(dur * fps)

        for track in range(1, tl.GetTrackCount("video") + 1):
            got = tl.GetItemListInTrack("video", track) or []
            print(f"  -> V{track}: {len(got)} items")
        print(f"  -> timeline duration "
              f"{(int(tl.GetEndFrame()) - start_frame) / fps:.3f}s")
        set_markers(tl, t.get("markers"), fps)

    pm.SaveProject()
    print("\nsaved.")

    d = spec.get("deliver")
    if not d:
        return
    out = os.path.expanduser(d.get("dir", "~/Desktop"))
    os.makedirs(out, exist_ok=True)
    project.DeleteAllRenderJobs()
    wanted = d.get("timelines") or [t["name"] for t in spec.get("timelines", [])]
    queued = 0
    for i in range(1, project.GetTimelineCount() + 1):
        tl = project.GetTimelineByIndex(i)
        if tl.GetName() not in wanted:
            continue
        project.SetCurrentTimeline(tl)
        project.SetCurrentRenderFormatAndCodec(d.get("format", "mp4"),
                                               d.get("codec", "H264"))
        settings = {"TargetDir": out, "CustomName": tl.GetName(),
                    "SelectAllFrames": True}
        if d.get("width"):
            settings["FormatWidth"] = int(d["width"])
            settings["FormatHeight"] = int(d["height"])
        project.SetRenderSettings(settings)
        if project.AddRenderJob():
            queued += 1
            print(f"queued  {tl.GetName()}")
    if not queued:
        print("nothing queued -- none of the named timelines exist")
        return
    print(f"\nrendering {queued} timeline(s) to {out} ...")
    project.StartRendering()
    import time
    while project.IsRenderingInProgress():
        time.sleep(5)
    for j in project.GetRenderJobList():
        st = project.GetRenderJobStatus(j["JobId"])
        print(f"  {j.get('OutputFilename', '?')}: {st.get('JobStatus')} "
              f"{st.get('CompletionPercentage', '')}%")
    pm.SaveProject()


if __name__ == "__main__":
    main()
