#!/usr/bin/env python3
"""Set the grade on the first node of selected timelines: a LUT, a CDL, or both.

    resolve-set-grade --lut "session grade.cube" --reset --only Fauré --save
    resolve-set-grade --slope "1.410 1.606 1.705" --only Brahms --save
    resolve-set-grade --lut "look.cube" --dry-run

These are the only two grades the scripting API can write. The colour wheels and
curves are not exposed, so anything more shaped than a per-channel gain has to
arrive as a LUT — `build-grade-lut` makes one from control points — while a gain,
which is the whole of a white balance, can go straight in as an ASC CDL slope.

Four things that each cost a run to find out.

**A LUT must be in Resolve's LUT library and the list must be refreshed.**
`--lut` copies the file there and calls `RefreshLUTList()` for you. Without the
refresh `SetLUT` returns `False` with no explanation. Resolve also caches by name,
so re-setting the same name is how you force a changed file to be re-read.

**`SetCDL` replaces the node's primary correction rather than stacking on it.** Set
0.9 over a hand-made 1.6 and the clip ends up at 0.9, not 1.44, so a slope must
always be the total wanted.

**Use `--reset` when switching kinds.** A node can hold a primary correction *and*
a LUT at once, so dropping a LUT onto a node that already has a gain applies both
and doubles the grade. `--reset` calls `ResetAllGrades()` on the node graph first,
which is what you want whenever the LUT is meant to be the whole grade.

**Nothing here can verify the result.** There is no `GetCDL`, and `GetLUT` only
returns a filename. Prove it by measurement: a still with the node enabled against
one with it disabled, then `frame-balance` on the graded still.
"""
import argparse
import os
import shutil
import sys

sys.path.append("/Library/Application Support/Blackmagic Design/DaVinci Resolve/"
                "Developer/Scripting/Modules")
os.environ.setdefault(
    "RESOLVE_SCRIPT_LIB",
    "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/"
    "Fusion/fusionscript.so")

LUT_LIBRARY = ("/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT")


def connect():
    try:
        import DaVinciResolveScript as dvr
    except ImportError:
        sys.exit("resolve-set-grade: Resolve's scripting module is not on the path")
    resolve = dvr.scriptapp("Resolve")
    if not resolve:
        sys.exit("resolve-set-grade: Resolve is not running")
    project = resolve.GetProjectManager().GetCurrentProject()
    if not project:
        sys.exit("resolve-set-grade: no project is open")
    return resolve, project


def video_items(timeline):
    items = []
    for track in range(1, timeline.GetTrackCount("video") + 1):
        items += timeline.GetItemListInTrack("video", track) or []
    return items


def triple(text, what):
    parts = text.split()
    if len(parts) != 3:
        sys.exit(f"resolve-set-grade: --{what} needs three numbers, got {text!r}")
    return " ".join(parts)


def install_lut(project, path):
    """Copy the cube into the LUT library and make Resolve re-read the list."""
    if not os.path.exists(path):
        sys.exit(f"resolve-set-grade: no such LUT {path}")
    name = os.path.basename(path)
    target = os.path.join(LUT_LIBRARY, name)
    if os.path.abspath(path) != target:
        shutil.copyfile(path, target)
        print(f"installed {name} in the LUT library")
    if not project.RefreshLUTList():
        sys.exit("resolve-set-grade: RefreshLUTList() failed; SetLUT would fail silently")
    return name


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--lut", help="path to a .cube; it is copied into the LUT library")
    ap.add_argument("--slope", help='ASC CDL per-channel gain, e.g. "1.4 1.6 1.7"')
    ap.add_argument("--offset", default="0 0 0")
    ap.add_argument("--power", default="1 1 1")
    ap.add_argument("--saturation", default="1")
    ap.add_argument("--reset", action="store_true",
                    help="ResetAllGrades() on the node graph first (use when setting a LUT)")
    ap.add_argument("--only", help="only timelines whose name contains this")
    ap.add_argument("--node", type=int, default=1, help="node index (default 1)")
    ap.add_argument("--save", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    if not args.lut and not args.slope:
        sys.exit("resolve-set-grade: give --lut, --slope, or both")

    resolve, project = connect()
    print(f"project: {project.GetName()}")

    targets = []
    for index in range(1, project.GetTimelineCount() + 1):
        timeline = project.GetTimelineByIndex(index)
        if args.only and args.only.lower() not in timeline.GetName().lower():
            continue
        for item in video_items(timeline):
            targets.append((timeline, item))
    if not targets:
        sys.exit(f"resolve-set-grade: no timeline matched --only {args.only!r}")

    if args.dry_run:
        print(f"\nwould touch {len(targets)} clip(s):")
        for timeline, _ in targets:
            print(f"  {timeline.GetName()}")
        print("\n--dry-run: nothing changed")
        return

    lut_name = install_lut(project, args.lut) if args.lut else None
    cdl = None
    if args.slope:
        cdl = {"NodeIndex": str(args.node), "Slope": triple(args.slope, "slope"),
               "Offset": triple(args.offset, "offset"), "Power": triple(args.power, "power"),
               "Saturation": args.saturation}

    print(f"\n{len(targets)} clip(s):")
    failed = 0
    for timeline, item in targets:
        graph = item.GetNodeGraph()
        steps = []
        if args.reset:
            steps.append(("reset", bool(graph.ResetAllGrades())))
        if cdl:
            steps.append(("cdl", bool(item.SetCDL(cdl))))
        if lut_name:
            steps.append(("lut", bool(graph.SetLUT(args.node, lut_name))))
            steps.append(("lut readback", graph.GetLUT(args.node) == lut_name))
        bad = [name for name, ok in steps if not ok]
        failed += bool(bad)
        state = "  ".join(f"{name}={'ok' if ok else 'FAILED'}" for name, ok in steps)
        print(f"  {'  ' if not bad else '!!'} {timeline.GetName():30s} {state}")

    if args.save:
        print(f"\nSaveProject: {resolve.GetProjectManager().SaveProject()}")
    else:
        print("\nSave the project in Resolve to keep this.")
    print("A LUT name reads back, but a CDL cannot — verify the look by measuring a "
          "still with the node enabled against one with it disabled.")

    if failed:
        sys.exit(f"resolve-set-grade: {failed} clip(s) did not take the grade")


if __name__ == "__main__":
    main()
