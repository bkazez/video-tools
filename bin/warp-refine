#!/usr/bin/env python3
"""Pin a warp map to the syllables, so a retimed shot fits consonant by consonant.

    warp-refine --warp warp.json --query raw-t6.wav --reference raw-t22.wav \
                --out warp-pinned.json --from 10 --to 80

`arc warp` aligns two takes globally and lands within a few tens of
milliseconds on average. That is not the same as landing on every syllable: on
legato singing the map drifted up to 218 ms at individual onsets while its
median error was 7 ms, and a fifth of a second is five frames of lips saying
something the sound is not saying yet.

This finds the onsets in both takes, pairs the ones the map already brings
close, and bends the map so each pair meets exactly. Between anchors it
interpolates, outside them it leaves the map alone, and it refuses any
correction that would make the map run backwards -- a retime that reverses is
worse than one that is late.

A pairing is only used when it is unambiguous: the nearest onset in the query
has to be at least twice as close as the next nearest, so a syllable matched to
its neighbour cannot drag the map onto the wrong word.

Feed the UNPROCESSED spot, not a mix and not a processed stem. A de-esser works
on exactly the sibilance this reads.
"""

import argparse
import bisect
import json
import subprocess
import sys

import numpy as np


def envelope(path, sr=16000, hop=0.005):
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", path,
                          "-af", f"aresample={sr}", "-ac", "1", "-f", "f32le", "-"],
                         capture_output=True).stdout
    x = np.frombuffer(raw, dtype=np.float32)
    h = int(sr * hop)
    n = len(x) // h
    e = np.abs(x[:n * h].reshape(n, h)).max(axis=1)
    return np.arange(n) * hop, 20 * np.log10(e + 1e-9)


def onsets(path, rise_db, floor_db, gap=0.12):
    t, db = envelope(path)
    out = []
    for i in range(10, len(t) - 4):
        peak = db[i:i + 3].max()
        if peak - db[i - 8:i - 1].max() > rise_db and peak > floor_db:
            if not out or t[i] - out[-1] > gap:
                out.append(float(t[i]))
    return np.array(out)


def monotone(points):
    """Fritsch-Carlson through the anchors: smooth, and it cannot run backwards."""
    xs = np.array([p[0] for p in points], float)
    ys = np.array([p[1] for p in points], float)
    h, d = np.diff(xs), np.diff(ys) / np.diff(xs)
    m = np.zeros_like(xs)
    m[1:-1] = (d[:-1] + d[1:]) / 2
    m[0], m[-1] = d[0], d[-1]
    for i in range(len(d)):
        if d[i] == 0:
            m[i] = m[i + 1] = 0
        else:
            a, b = m[i] / d[i], m[i + 1] / d[i]
            if a * a + b * b > 9:
                t = 3.0 / np.sqrt(a * a + b * b)
                m[i], m[i + 1] = t * a * d[i], t * b * d[i]

    def curve(x):
        x = np.clip(np.asarray(x, float), xs[0], xs[-1])
        i = np.clip(np.searchsorted(xs, x, side="right") - 1, 0, len(xs) - 2)
        u = (x - xs[i]) / h[i]
        u2, u3 = u * u, u * u * u
        return ((2 * u3 - 3 * u2 + 1) * ys[i] + (u3 - 2 * u2 + u) * h[i] * m[i]
                + (-2 * u3 + 3 * u2) * ys[i + 1] + (u3 - u2) * h[i] * m[i + 1])

    return curve


def at(reference, query, t):
    i = bisect.bisect_left(reference, t)
    i = max(1, min(i, len(reference) - 1))
    span = reference[i] - reference[i - 1]
    f = (t - reference[i - 1]) / span if span > 0 else 0.0
    return query[i - 1] + f * (query[i] - query[i - 1])


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--warp", required=True)
    ap.add_argument("--query", required=True, help="the donor take's unprocessed spot")
    ap.add_argument("--reference", required=True, help="the released take's unprocessed spot")
    ap.add_argument("--out", required=True)
    ap.add_argument("--from", dest="start", type=float, default=0.0)
    ap.add_argument("--to", dest="end", type=float, default=1e9)
    ap.add_argument("--rise", type=float, default=4.0, help="dB that counts as an onset")
    ap.add_argument("--floor", type=float, default=-40.0, help="dBFS an onset must reach")
    ap.add_argument("--max-shift", type=float, default=0.25,
                    help="seconds; a pairing further apart than this is not a pairing")
    ap.add_argument("--min-speed", type=float, default=0.85,
                    help="slowest the corrected map may run. Below about 0.85 the "
                         "retime is visible, and at 0 it is a freeze")
    ap.add_argument("--max-speed", type=float, default=1.18)
    ap.add_argument("--smooth", type=float, default=1.5,
                    help="seconds over which to average the map's speed before "
                         "anchoring. A DTW map moves in whole steps -- half "
                         "speed, same speed, double speed -- and followed frame "
                         "by frame those steps are stutter and freeze, not "
                         "timing. Below about 0.5 they start to show")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    model = json.load(open(args.warp))
    query, reference = model["map"]

    qo = onsets(args.query, args.rise, args.floor)
    ro = onsets(args.reference, args.rise, args.floor)
    print(f"onsets {len(qo)} in the donor, {len(ro)} in the reference")

    # The DTW path's job here is only to say which onset goes with which. Its
    # own shape is not usable as timing: the path moves in whole steps, so its
    # speed reads 0.5x, 1x or 2x and nothing between, and a retime that follows
    # it frame by frame reproduces those steps as stutter and as freezes. On
    # this shot it held at half speed for 39 segments and skipped at double for
    # 94, about 93 ms each.
    pairs = []
    for t in ro:
        if not (args.start <= t <= args.end):
            continue
        pred = at(reference, query, t)
        d = np.abs(qo - pred)
        j = int(np.argmin(d))
        if d[j] > args.max_shift:
            continue
        second = np.partition(d, 1)[1] if len(d) > 1 else 1e9
        if second < 2 * d[j]:           # ambiguous: two onsets equally close
            continue
        pairs.append((float(t), float(qo[j])))
    if len(pairs) < 3:
        sys.exit(f"warp-refine: only {len(pairs)} onsets paired -- not a curve")

    before = np.array([q - at(reference, query, r) for r, q in pairs])
    print(f"paired {len(pairs)} onsets unambiguously; the map misses them by "
          f"median {np.median(before) * 1000:+.0f} ms, "
          f"p90 {np.percentile(np.abs(before), 90) * 1000:.0f} ms, "
          f"max {np.abs(before).max() * 1000:.0f} ms")

    # Two performances of the same music drift by a few percent over seconds.
    # A pair implying more than that is a syllable matched to its neighbour,
    # and one bad pair bends the curve through everything near it.
    kept = [pairs[0]]
    for r, q in pairs[1:]:
        dr, dq = r - kept[-1][0], q - kept[-1][1]
        if dr > 0 and args.min_speed <= dq / dr <= args.max_speed:
            kept.append((r, q))
    if len(kept) < len(pairs):
        print(f"       dropped {len(pairs) - len(kept)} pair(s) implying a speed "
              f"outside {args.min_speed:g}-{args.max_speed:g}")
    pairs = kept

    # Carry the map's own answer at the ends, so the curve is defined where no
    # onset was found and joins what came before.
    lo, hi = args.start, min(args.end, reference[-1])
    knots = ([(lo, at(reference, query, lo))] if pairs[0][0] - lo > 0.5 else []) \
        + pairs + ([(hi, at(reference, query, hi))] if hi - pairs[-1][0] > 0.5 else [])

    curve = monotone(knots)
    grid = np.arange(reference[0], reference[-1], 0.02)
    inside = (grid >= knots[0][0]) & (grid <= knots[-1][0])
    walked = np.interp(grid, reference, query)
    walked[inside] = curve(grid[inside])
    # Outside the anchors the map is untouched, so join the two without a step.
    for edge, sign in ((knots[0][0], -1), (knots[-1][0], 1)):
        step = curve(np.array([edge]))[0] - np.interp(edge, reference, query)
        side = grid < edge if sign < 0 else grid > edge
        blend = np.clip(1 - np.abs(grid[side] - edge) / 1.0, 0, 1)
        walked[side] += step * blend

    # Only inside the anchors: outside them the map is left alone, staircase
    # and all, and reporting that would describe frames nobody is using.
    speed = np.gradient(walked, grid)[inside]
    print(f"speed  {speed.min():.3f}x to {speed.max():.3f}x "
          f"over {knots[0][0]:.1f}-{knots[-1][0]:.1f} s, the anchored span")
    if speed.min() < args.min_speed or speed.max() > args.max_speed:
        print(f"       !! outside {args.min_speed:g}-{args.max_speed:g}: "
              f"the picture will lurch or freeze there")

    after = np.array([q - np.interp(r, grid, walked) for r, q in pairs])
    print(f"       the curve misses them by median {np.median(after) * 1000:+.0f} ms, "
          f"p90 {np.percentile(np.abs(after), 90) * 1000:.0f} ms, "
          f"max {np.abs(after).max() * 1000:.0f} ms")
    new, reference = list(walked), list(grid)

    if args.dry_run:
        return
    model["map"] = [list(new), list(reference)]
    model["refined_anchors"] = len(pairs)
    with open(args.out, "w") as fh:
        json.dump(model, fh)
    print(f"wrote  {args.out}")


if __name__ == "__main__":
    main()
