#!/usr/bin/env node
/**
 * Render an HTML file to PDF at a physical paper size.
 *
 *     html-to-pdf docs/focus-card.html                 -> docs/focus-card.pdf
 *     html-to-pdf card.html --size 5inx3in -o out.pdf
 *
 * The page's own `@page { size: … }` wins when it has one, which is where a card
 * should declare its size — this only supplies a default and the paper to print
 * on. Backgrounds are always printed; a card whose rules vanish is not a card.
 *
 * chrome-headless-shell, never full Chrome: on macOS 26 some Chrome builds stop
 * producing frames headlessly and every render hangs until the browser dies.
 */
const fs = require('fs');
const path = require('path');

const PUPPETEER = '/Users/bkazez/Projects/visual-test-tools/node_modules/puppeteer';

function parseArgs(argv) {
  const args = { size: '5inx3in' };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-o' || a === '--out') args.out = argv[++i];
    else if (a === '-s' || a === '--size') args.size = argv[++i];
    else if (a === '-h' || a === '--help') args.help = true;
    else if (!args.input) args.input = a;
    else { console.error(`html-to-pdf: unexpected argument ${a}`); process.exit(2); }
  }
  return args;
}

(async () => {
  const args = parseArgs(process.argv.slice(2));
  if (args.help || !args.input) {
    console.log('usage: html-to-pdf FILE.html [--size 5inx3in] [-o OUT.pdf]');
    process.exit(args.help ? 0 : 2);
  }
  const input = path.resolve(args.input);
  if (!fs.existsSync(input)) {
    console.error(`html-to-pdf: no such file: ${input}`);
    process.exit(1);
  }
  const out = path.resolve(args.out || input.replace(/\.html?$/i, '.pdf'));

  const m = /^([\d.]+(?:in|mm|cm|px))x([\d.]+(?:in|mm|cm|px))$/i.exec(args.size);
  if (!m) {
    console.error(`html-to-pdf: --size must look like 5inx3in, got ${args.size}`);
    process.exit(2);
  }

  const puppeteer = require(PUPPETEER);
  const browser = await puppeteer.launch({ headless: 'shell' });
  try {
    const page = await browser.newPage();
    await page.goto('file://' + input, { waitUntil: 'networkidle0' });
    await page.pdf({
      path: out, width: m[1], height: m[2],
      printBackground: true, preferCSSPageSize: true,
      margin: { top: 0, right: 0, bottom: 0, left: 0 },
    });
  } finally {
    await browser.close();
  }
  console.log(out);
})().catch((err) => { console.error(err); process.exit(1); });
