#!/usr/bin/env python3
"""demo-video - a product's film with the maker talking over it, at 1920x1080,
the plain YouTube demo Hacker News asks a Show HN for an app to link.

    demo-video ~/Projects/wavelength/marketing/wavelength.mp4 --out demo.mp4 [--device NAME]
    arc youtube upload demo.mp4 --title "Wavelength demo" --privacy unlisted

The picture is the film the product page already plays (bin/make-video in the
product's repo, built with product-video), so there is no second film to keep
up. A film that is not 16:9 is fitted inside a black 1920x1080 frame.

It plays the film full screen at once and records the voice with `arc capture`,
trims the voice to the film, sets it to -14 LUFS (YouTube's playback level) and
muxes it. One take, no script; run it again to retake.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
import time

WIDTH, HEIGHT, RATE = 1920, 1080, 30
LUFS, TRUE_PEAK = -14, -1.5


def run(*cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def duration(path):
    return float(run("ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path,
                     capture_output=True, text=True).stdout)


def loudness(path):
    stderr = run("ffmpeg", "-hide_banner", "-i", path, "-af",
                 f"loudnorm=I={LUFS}:TP={TRUE_PEAK}:LRA=11:print_format=json", "-f", "null", "-",
                 capture_output=True, text=True).stderr
    return json.loads(stderr[stderr.rindex("{"):stderr.rindex("}") + 1])


def fitted(film, work):
    picture = os.path.join(work, "picture.mp4")
    run("ffmpeg", "-v", "error", "-y", "-i", film, "-an",
        "-vf", f"fps={RATE},scale={WIDTH}:{HEIGHT}:force_original_aspect_ratio=decrease:flags=lanczos,"
               f"pad={WIDTH}:{HEIGHT}:(ow-iw)/2:(oh-ih)/2:black,setsar=1,format=yuv420p",
        "-c:v", "libx264", "-preset", "slow", "-crf", "16", "-profile:v", "high", picture)
    return picture


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("film")
    parser.add_argument("--out", required=True)
    parser.add_argument("--device", help="input device for arc capture; default is arc's preference")
    args = parser.parse_args()

    with tempfile.TemporaryDirectory() as work:
        picture = fitted(args.film, work)
        seconds = duration(picture)
        voice = os.path.join(work, "voice.wav")
        capture = ["arc", "capture", "--seconds", str(int(seconds) + 3), "--out", voice]
        if args.device:
            capture += ["--device", args.device]
        recorder = subprocess.Popen(capture, stdout=subprocess.DEVNULL)
        capture_started = time.time()
        time.sleep(1)
        playback_started = time.time()
        run("ffplay", "-v", "error", "-fs", "-autoexit", "-an", picture)
        if recorder.wait():
            sys.exit(f"demo-video: arc capture failed ({recorder.returncode})")

        trimmed = os.path.join(work, "trimmed.wav")
        run("ffmpeg", "-v", "error", "-y", "-ss", f"{playback_started - capture_started:.3f}",
            "-t", f"{seconds:.3f}", "-i", voice, trimmed)
        measured = loudness(trimmed)
        loudnorm = (f"loudnorm=I={LUFS}:TP={TRUE_PEAK}:LRA=11:linear=true"
                    f":measured_I={measured['input_i']}:measured_TP={measured['input_tp']}"
                    f":measured_LRA={measured['input_lra']}:measured_thresh={measured['input_thresh']}"
                    f":offset={measured['target_offset']}")
        run("ffmpeg", "-v", "error", "-y", "-i", picture, "-i", trimmed,
            "-map", "0:v", "-map", "1:a", "-c:v", "copy", "-af", f"{loudnorm},aresample=48000",
            "-c:a", "aac", "-b:a", "256k", "-ac", "2", "-shortest", "-movflags", "+faststart", args.out)
    print(args.out)


if __name__ == "__main__":
    main()
