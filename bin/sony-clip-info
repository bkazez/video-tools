#!/usr/bin/env python3
"""What a Sony camera actually recorded, read out of the clip itself.

Copying clips off the card as bare .MP4 leaves the CLIP/*.XML sidecars behind,
and that XML is where most tools expect to find the camera's own account of the
shot. The real-time metadata track inside the file carries it too, so nothing is
really lost.

Four things this answers that ffprobe cannot:

  * **Slow motion.** In S&Q mode the camera captures at one rate and writes the
    file at another, so a clip reports a duration that is a multiple of its real
    length and every sync calculation built on that duration is wrong. The
    capture rate is stated outright in the metadata; the ratio against the
    container rate is the retime factor.

  * **Capture gamma.** S-Log3 footage is untagged in the container
    (color_transfer=unknown), so a grading app has no way to know. The embedded
    LUT name gives it away, and the luma statistics confirm it.

  * **Wall clock.** The camera's own clock at the first frame, which is what
    lets footage be lined up against a separate audio recorder.

  * **Whether anything refocused.** The lens writes its aperture, focus and zoom
    per frame, so a rack in the middle of a long take is a fact in the file rather
    than something to spot by eye. That is the check for a shot set up on a
    stand-in: focus was put where it belongs and nothing moved it afterwards.

Usage:
    sony-clip-info CLIP.MP4 [CLIP2.MP4 ...]
    sony-clip-info /path/to/Video/            # every clip in a folder
    sony-clip-info --json Video/              # machine-readable
    sony-clip-info --deep Video/C0490.MP4     # also check audio and picture
    sony-clip-info --verify Video/C0490.MP4   # re-read the clock at the last
                                              # frame to confirm the factor

## Checking the camera was set right, before the day is spent

A camera has dozens of settings, they get changed for one shot and left, and a
reset puts them all back to factory. Nothing on the body tells you the combination
is wrong, and the cost lands weeks later in the edit: 8-bit log that will not take
a grade, S&Q that records no audio and so cannot be synced.

So shoot three seconds, and ask the file:

    sony-clip-info --expect bit_depth=10 --expect slowmo=no /Volumes/CARD/…/C0001.MP4
    sony-clip-info --expect camera-profile.yml Video/     # a YAML file of the same keys

It exits non-zero and says which setting is wrong, per clip. Do it on arrival, on
the actual card, before anything that matters is recorded. Checkable keys:

    bit_depth   chroma      slowmo    log      audio     resolution
    codec       capture_fps container_fps      iso       white_balance_k
    shutter_angle           focus     zoom     aperture

Values may carry a comparison: `iso="<=6400"`, `shutter_angle=">=170"`. `audio`
and `log` need `--deep`.

`focus`, `zoom` and `aperture` are `locked` or `moved`, read from the lens's own
per-frame metadata at both ends of the take, or at eight points with `--deep`.
"""
import argparse, glob, json, os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from sonyrtmd import describe, f_number

LENS_LABELS = {"focus_distance_raw": "distance ", "focus_ring_raw": "ring ",
               "zoom_35mm_raw": "35mm-equiv ", "focal_length_raw": "focal length ",
               "zoom_ring_raw": "ring ", "iris_f_raw": ""}


def lens_value(tag, raw):
    return f"f/{f_number(raw)[0]:g}" if tag == "iris_f_raw" else str(raw)


def fmt(rec):
    L = []
    a = L.append
    a(f"{rec['file']}")
    a(f"  {rec.get('width')}x{rec.get('height')} {rec.get('codec')} "
      f"{rec.get('pix_fmt')} range={rec.get('color_range')}")
    if rec.get("model_serial"):
        a(f"  camera            {rec['model_serial']}")
    if rec.get("clock"):
        a(f"  started           {rec['clock']}  (camera clock)")
    if rec.get("timecode"):
        a(f"  timecode          {rec['timecode']}")
    cf = rec.get("container_fps") or 0
    if rec.get("capture_fps"):
        a(f"  frame rate        captured {rec['capture_fps']:g} fps, "
          f"written {cf:g} fps")
    if rec.get("is_slowmo"):
        a(f"  ** SLOW MOTION    {rec['slowmo_factor']:g}x -- "
          f"file runs {rec['duration']:.2f}s but is "
          f"{rec['real_duration']:.2f}s of real time")
        a(f"                    retime to {rec['slowmo_factor']*100:g}% for real speed")
    elif rec.get("slowmo_factor"):
        a(f"  speed             real time")
    if rec.get("shutter"):
        line = f"  shutter           {rec['shutter']}"
        if rec.get("shutter_angle_capture"):
            line += f"  ({rec['shutter_angle_capture']:g}° at the capture rate)"
        a(line)
    if rec.get("iso"):
        line = f"  ISO               {rec['iso']}"
        if rec.get("master_gain_db") is not None:
            line += f"  (master gain {rec['master_gain_db']:+g} dB)"
        if rec.get("iso_gain_agree") is False:
            line += "  !! gain and ISO disagree -- tag mapping may be wrong"
        a(line)
    if rec.get("white_balance_k"):
        a(f"  white balance     {rec['white_balance_k']} K")
    for group in ("focus", "zoom", "aperture"):
        state = (rec.get("lens") or {}).get(group)
        if not state:
            continue
        # Only the aperture has a decoded unit; the rest are the lens's own
        # encoder counts, which say "it moved" and deliberately claim nothing more.
        held = f"held ({rec.get('lens_samples', 0)} samples identical)"
        if group == "aperture" and rec.get("aperture"):
            held = f"f/{rec['aperture']:g}, " + held
            if rec.get("aperture_on_ladder") is False:
                held += "  !! not a standard stop -- iris decode may be wrong"
        if not state["moved"]:
            a(f"  {group:<17} {held}")
            continue
        a(f"  ** {group.upper()} MOVED   {state['at']:.0f}s into the clip: "
          + ", ".join(f"{LENS_LABELS.get(tag, tag)}{lens_value(tag, lo)}"
                      f" -> {lens_value(tag, hi)}"
                      for tag, (lo, hi) in sorted(state["range"].items())
                      if lo != hi))
    if rec.get("embedded_lut"):
        a(f"  embedded LUT      {', '.join(rec['embedded_lut'])}")
        if any("SL3" in x or "SLog3" in x for x in rec["embedded_lut"]):
            a( "                    -> shot S-Log3 / S-Gamut3.Cine")
    if rec.get("audio_silent") is True:
        a( "  audio             SILENT (all zero) -- cannot be synced by audio")
    elif rec.get("audio_silent") is False:
        a(f"  audio             {rec.get('audio_codec')}, has signal")
    if rec.get("looks_like_log"):
        y = rec["luma"]
        a(f"  picture           log-like (YMAX {y['YMAX']:.0f}, SATAVG {y['SATAVG']:.1f})")
    if rec.get("measured_factor"):
        a(f"  verified          clock says {rec['measured_factor']:g}x "
          f"({rec['clock']} -> {rec['clock_end']})")
    if rec.get("parse_ok") is False:
        a(f"  !! metadata parse looks wrong (imager aspect {rec['imager_aspect']})")
    if rec.get("note"):
        a(f"  {rec['note']}")
    return "\n".join(L)


def lens_held(group):
    """`locked` or `moved` for one lens control, from the sampled readings."""
    def read(rec):
        state = (rec.get("lens") or {}).get(group)
        return None if state is None else ("moved" if state["moved"] else "locked")
    return read


def bit_depth(rec):
    pix = rec.get("pix_fmt") or ""
    for depth in ("16", "12", "10"):
        if depth + "le" in pix or depth + "be" in pix:
            return int(depth)
    return 8 if pix else None


def chroma(rec):
    pix = rec.get("pix_fmt") or ""
    for layout in ("444", "422", "420"):
        if layout in pix:
            return layout
    return None


# Each key answers one question a camera can be set wrongly about.
CHECKS = {
    "bit_depth": bit_depth,
    "chroma": chroma,
    "slowmo": lambda r: "yes" if r.get("is_slowmo") else "no",
    "log": lambda r: ("yes" if any("SL3" in x or "SLog3" in x
                                   for x in r.get("embedded_lut") or []) else "no"),
    "audio": lambda r: (None if r.get("audio_silent") is None
                        else ("silent" if r["audio_silent"] else "has_signal")),
    "resolution": lambda r: (f"{r['width']}x{r['height']}" if r.get("width") else None),
    "codec": lambda r: r.get("codec"),
    "capture_fps": lambda r: r.get("capture_fps"),
    "container_fps": lambda r: r.get("container_fps"),
    "iso": lambda r: r.get("iso"),
    "white_balance_k": lambda r: r.get("white_balance_k"),
    "shutter_angle": lambda r: r.get("shutter_angle_capture"),
    "focus": lens_held("focus"),
    "zoom": lens_held("zoom"),
    "aperture": lens_held("aperture"),
}


def compare(got, want):
    """want may be a bare value, `<=`/`>=`/`<`/`>` , or a `LO..HI` range."""
    text = str(want).strip()
    if ".." in text:
        low, _, high = text.partition("..")
        try:
            value, low, high = float(got), float(low), float(high)
        except (TypeError, ValueError):
            return False, f"{got!r} is not a number to compare against {text}"
        return low <= value <= high, f"{got:g} vs {low:g}..{high:g}"
    for op in ("<=", ">=", "<", ">"):
        if text.startswith(op):
            try:
                limit, value = float(text[len(op):]), float(got)
            except (TypeError, ValueError):
                return False, f"{got!r} is not a number to compare {op}{text[len(op):]}"
            ok = {"<=": value <= limit, ">=": value >= limit,
                  "<": value < limit, ">": value > limit}[op]
            return ok, f"{got} vs {op}{limit:g}"
    try:
        ok = float(got) == float(text)
    except (TypeError, ValueError):
        ok = str(got).lower() == text.lower()
    return ok, f"{got} vs {text}"


def run_expectations(recs, expectations):
    """Print a pass/fail line per clip. Returns the number of clips that failed."""
    unknown = set(expectations) - set(CHECKS)
    if unknown:
        sys.exit("sony-clip-info: no such check(s): " + ", ".join(sorted(unknown))
                 + "\n  known: " + ", ".join(sorted(CHECKS)))
    failed = 0
    for rec in recs:
        problems, missing = [], []
        for key, want in expectations.items():
            got = CHECKS[key](rec)
            if got is None:
                missing.append(key)
                continue
            ok, why = compare(got, want)
            if not ok:
                problems.append(f"{key} {why}")
        failed += bool(problems)
        state = "FAIL" if problems else "ok  "
        print(f"{state}  {rec['file']}" + (f"   {'; '.join(problems)}" if problems else ""))
        if missing:
            print(f"      not readable from this clip: {', '.join(missing)}"
                  + ("  (try --deep)" if {"audio", "log"} & set(missing) else ""))
    print(f"\n{len(recs) - failed}/{len(recs)} clip(s) match all "
          f"{len(expectations)} expectation(s)")
    return failed


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="+", help="clips, or folders of clips")
    ap.add_argument("--expect", action="append", default=[], metavar="KEY=VALUE|FILE.yml",
                    help="assert a camera setting, or a YAML file of them; repeatable")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--verify", action="store_true",
                    help="re-read the clock at the last frame to confirm the "
                         "slow-motion factor (reads the whole file)")
    ap.add_argument("--deep", action="store_true",
                    help="also check for silent audio and measure the picture")
    args = ap.parse_args()

    files = []
    for p in args.paths:
        if os.path.isdir(p):
            for ext in ("MP4", "mp4", "MXF", "mxf"):
                files += sorted(glob.glob(os.path.join(p, f"*.{ext}")))
        else:
            files.append(p)
    if not files:
        sys.exit("no clips found")

    expectations = {}
    for item in args.expect:
        if "=" in item:
            key, _, value = item.partition("=")
            expectations[key.strip()] = value.strip()
            continue
        if not os.path.exists(item):
            sys.exit(f"sony-clip-info: --expect {item!r} is neither KEY=VALUE nor a file")
        import yaml
        with open(item) as fh:
            loaded = yaml.safe_load(fh) or {}
        if not isinstance(loaded, dict):
            sys.exit(f"sony-clip-info: {item} must be a flat mapping of checks")
        expectations.update({str(k): v for k, v in loaded.items()})

    recs = [describe(f, verify=args.verify, deep=args.deep) for f in files]
    if args.json:
        print(json.dumps(recs, indent=2))
    elif expectations:
        if run_expectations(recs, expectations):
            sys.exit(1)
    else:
        for r in recs:
            print(fmt(r)); print()


if __name__ == "__main__":
    main()
