#!/usr/bin/env python3
"""Is the white in the shot actually white, and what trim would make it so.

    frame-balance Video/C0485.MP4 --at 30
    frame-balance still.png graded.png
    frame-balance shot*.png --gain 1.606        # fold into an existing gain
    frame-balance clip.MP4 --at 30 --region 1300,1550,600,550 --json

A cast is otherwise argued about by eye, which fails in both directions: a warm
room *should* look warm, so "it looks fine" survives a real cast, and a corrected
picture reads as cold to whoever spent an hour looking at the uncorrected one.

**The measurement.** Take the brightest lightly-coloured pixels in the frame —
between the 85th and 99.5th percentile of luma, and within `--sat` of neutral —
and report the median R:G:B of that. In a shot with a white shirt, a lit page, or
a plaster wall in it, that patch is the illuminant, and its channel ratios are the
cast. From there the trim is arithmetic: the per-channel gain that lands the patch
at R = G = B, printed as an ASC CDL slope you can hand to
`TimelineItem.SetCDL()`.

Percentiles rather than fixed levels, so it reads a graded frame and an ungraded
log conversion the same way.

**When it lies:** when the brightest lightly-coloured thing is not neutral. A shot
of a red curtain will confidently report the curtain. Two cases that come up for
real, both fixable:

- **A dark interior.** The lit page or a lamp is brighter than the subject's face,
  so the patch is paper, not skin — which is what you want here, but do not read
  the same number as a skin measurement.
- **A graded frame where the subject is now bright.** Skin at 65% starts passing
  the neutrality test at the default `--sat 0.16` and drags the reading warm.
  Tighten to `--sat 0.06` on graded frames; if the answer moves, it was catching
  skin.

Check the `%frame` column against what you know is in the shot, run several frames
and look at the spread, and use `--region` when you want a patch you have actually
identified.

`--gain G` multiplies the printed slope by G, for folding a white balance into a
gain that is already there rather than adding a second operator.
"""
import argparse
import json
import os
import subprocess
import sys

import numpy as np

IMAGE_EXT = {".png", ".tif", ".tiff", ".jpg", ".jpeg", ".bmp", ".ppm", ".dpx", ".exr"}


def read_rgb(path, at):
    """One frame as an (h, w, 3) uint8 array, from a still or a clip."""
    cmd = ["ffmpeg", "-v", "error"]
    if os.path.splitext(path)[1].lower() not in IMAGE_EXT:
        cmd += ["-ss", str(at)]
    cmd += ["-i", path, "-vframes", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
    size = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
         "stream=width,height", "-of", "csv=p=0", path],
        capture_output=True, text=True, check=True).stdout.strip()
    width, height = (int(v) for v in size.split(",")[:2])
    raw = subprocess.run(cmd, capture_output=True, check=True).stdout
    if len(raw) < width * height * 3:
        sys.exit(f"frame-balance: no frame at {at}s in {path}")
    return np.frombuffer(raw[:width * height * 3], np.uint8).reshape(height, width, 3)


def white_patch(rgb, region, sat, lo, hi):
    """The brightest near-neutral pixels: (median RGB, share of the frame)."""
    if region:
        x, y, w, h = region
        rgb = rgb[y:y + h, x:x + w]
    flat = rgb.reshape(-1, 3).astype(np.float32)
    luma = flat @ np.array([0.2126, 0.7152, 0.0722], np.float32)
    span = flat.max(1) - flat.min(1)
    keep = ((luma >= np.percentile(luma, lo)) & (luma <= np.percentile(luma, hi))
            & (span < sat * np.maximum(flat.max(1), 1)))
    if keep.sum() < 500:
        return None, 0.0
    return np.median(flat[keep], axis=0), keep.mean()


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("frames", nargs="+", help="stills or clips")
    ap.add_argument("--at", type=float, default=0.0, help="seconds into a clip (default 0)")
    ap.add_argument("--region", help="x,y,w,h to measure inside instead of the whole frame")
    ap.add_argument("--sat", type=float, default=0.16,
                    help="how neutral a pixel must be: (max-min)/max below this (default 0.16)")
    ap.add_argument("--percentiles", default="85,99.5",
                    help="luma percentile band the patch is taken from (default 85,99.5)")
    ap.add_argument("--gain", type=float, default=1.0,
                    help="fold the trim into this existing gain (default 1.0)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    region = tuple(int(v) for v in args.region.split(",")) if args.region else None
    lo, hi = (float(v) for v in args.percentiles.split(","))

    rows = []
    for path in args.frames:
        med, share = white_patch(read_rgb(path, args.at), region, args.sat, lo, hi)
        if med is None:
            print(f"frame-balance: no near-neutral pixels in {path}", file=sys.stderr)
            continue
        rows.append({"frame": os.path.basename(path), "rgb": [round(float(v), 1) for v in med],
                     "r_over_g": float(med[0] / med[1]), "b_over_g": float(med[2] / med[1]),
                     "share_of_frame": float(share)})

    if not rows:
        sys.exit("frame-balance: nothing measurable")

    pooled_r = float(np.median([r["r_over_g"] for r in rows]))
    pooled_b = float(np.median([r["b_over_g"] for r in rows]))
    trim = [1 / pooled_r, 1.0, 1 / pooled_b]
    slope = [args.gain * t for t in trim]
    result = {"frames": rows, "pooled": {"r_over_g": pooled_r, "b_over_g": pooled_b},
              "trim": trim, "gain": args.gain, "cdl_slope": slope}

    if args.json:
        print(json.dumps(result, indent=2))
        return

    print(f"{'frame':34s} {'R':>6s}{'G':>6s}{'B':>6s}   {'R/G':>6s} {'B/G':>6s}  %frame")
    for r in rows:
        red, green, blue = r["rgb"]
        print(f"{r['frame']:34s} {red:6.1f}{green:6.1f}{blue:6.1f}   "
              f"{r['r_over_g']:6.3f} {r['b_over_g']:6.3f}  {r['share_of_frame'] * 100:5.2f}%")
    if len(rows) > 1:
        print(f"\n{'pooled median':34s} {'':18s}   {pooled_r:6.3f} {pooled_b:6.3f}")

    warm = "warm" if pooled_r > 1 else "cool"
    print(f"\nThe white reference is {abs(pooled_r - 1) * 100:.1f}% {warm} in red and "
          f"{abs(pooled_b - 1) * 100:.1f}% {'high' if pooled_b > 1 else 'low'} in blue.")
    print(f"trim to neutral, green held:  {trim[0]:.3f} 1.000 {trim[2]:.3f}")
    print(f"ASC CDL slope at gain {args.gain:g}:   "
          f"{slope[0]:.3f} {slope[1]:.3f} {slope[2]:.3f}")
    print("\nThis assumes the brightest near-neutral thing in frame really is neutral.\n"
          "Check %frame against what is in the shot before believing it.")


if __name__ == "__main__":
    main()
